{
  "name": "chefmind",
  "private": true,
  "workspaces": [
    "packages/*",
    "app",
    "desktop"
  ],
  "scripts": {
    "test": "npm run test:core && npm run test:app",
    "test:core": "npm -w @calmind/core run test -- --run",
    "test:app": "npx vitest run --root app",
    "web": "npm -w chefmind-app run web",
    "export:web": "npm -w chefmind-app exec expo export -- -p web",
    "desktop": "npm -w @chefmind/desktop run build",
    "desktop:dev": "npm -w @chefmind/desktop run dev",
    "typecheck": "npx tsc --noEmit -p packages/core && npx tsc --noEmit -p app",
    "deploy": "sh deploy.sh",
    "dtp": "sh tools/dtp.sh",
    "tdtp": "sh tools/tdtp.sh",
    "test:deploy": "sh tools/check-deploy-guards.sh"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "version": "1.23.0"
}

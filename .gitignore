# Dependencies and build output
node_modules/
app/dist/
app/.expo/
app/web-build/

# Continuous native generation — ios/ and android/ are prebuild output,
# regenerated by `npx expo prebuild`; they are disposable. (But note
# app/ios/build/ holds ReactCodegen sources written by `pod install` —
# gitignored AND not safely deletable. See AGENTS.md.)
app/ios/
app/android/

# The deploy login. No config ever rides along with source.
deploy.conf

# Tauri build output; gen/ is regenerated on every build.
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/dist-desktop/

# Test artefacts, never source
test-results/
*.log

# Claude Code machine-local state; launch.json is repo config and IS tracked
.claude/*
!.claude/launch.json

.DS_Store
